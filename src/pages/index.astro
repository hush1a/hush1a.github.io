---
import { getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ContactCTA from "@components/ContactCTA.astro";
import SocialLinks from "@components/SocialLinks.astro";
import AnimatedButton from "@components/AnimatedButton.astro";
import TerminalCard from "@components/TerminalCard.astro";
import SonarGrid from "@components/SonarGrid.astro";
import TechMarquee from "@components/TechMarquee.astro";
import AboutHighlights from "@components/AboutHighlights.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, ABOUT } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <!-- Whole-page backdrop: pinned to the viewport behind all content, so it
       stays put while the page scrolls over it. -->
  <SonarGrid class="fixed inset-0 -z-10 opacity-40 dark:opacity-30" pingEvery={6} />
  <Container>
    <!-- Hero: heading, one-line intro, actions, and the terminal. One screen
         tall (main already pads the top by 8rem), content centred a little
         above the middle: the larger bottom padding lifts it to the optical
         centre rather than the geometric one. -->
    <section class="relative grid content-center min-h-[calc(100dvh-8rem)] pb-[22dvh] lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16 lg:items-center">
      <div class="relative space-y-8 max-w-3xl">
        <h1 class="animate text-4xl sm:text-6xl leading-tight tracking-tight text-black dark:text-white font-bold">
          Hello, I'm <span class="text-orange-600 dark:text-orange-300">hush</span>.
        </h1>

        <p class="animate max-w-xl text-lg leading-relaxed">
          CS student at UGM, on exchange at Jeonbuk National University. I build software, solve business problems with tech, and write CTF writeups.
        </p>

        <div class="animate flex flex-wrap items-center gap-3">
          <AnimatedButton href="/projects" variant="primary" size="lg">
            View projects
            <svg
              slot="icon-right"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-transform duration-200 group-hover:translate-x-0.5"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </AnimatedButton>
          <SocialLinks />
        </div>
      </div>

      <!-- Interactive terminal, desktop-only: typing commands on a phone
           keyboard is clunky, and everything it prints is also on the page. -->
      <div class="animate relative hidden lg:block lg:w-[28rem]">
        <TerminalCard />
      </div>
    </section>

    <!-- Below the hero, strongest proof first: who I am, what I've built,
         where I've worked, then (once there are any) blog posts. -->
    <section class="animate space-y-6 py-12">
      <SectionHeading title="About me" />
      <article>
        <p>
          {ABOUT}
        </p>
      </article>

      <AboutHighlights />

      <div class="space-y-4 pt-4">
        <h3 class="font-semibold text-black dark:text-white">
          Technologies I've worked with
        </h3>
        <TechMarquee />
        <div class="flex justify-center pt-2">
          <AnimatedButton href="/certifications" size="lg" class="w-full max-w-md">
            View my professional certifications
            <svg
              slot="icon-right"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-transform duration-200 group-hover:translate-x-0.5"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </AnimatedButton>
        </div>
      </div>
    </section>

    {projects.length > 0 && (
      <section class="animate space-y-6 py-12">
        <SectionHeading title="Recent projects" href="/projects" linkLabel="See all projects" />
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {projects.map(project => (
            <li>
              <ProjectCard entry={project} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {work.length > 0 && (
      <section class="animate space-y-6 py-12">
        <SectionHeading title="Experience" href="/work" linkLabel="See all experience" />
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}

    {blog.length > 0 && (
      <section class="animate space-y-6 py-12">
        <SectionHeading title="Latest posts" href="/blog" linkLabel="See all posts" />
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="animate py-12">
      <ContactCTA />
    </section>
  </Container>
</PageLayout>
