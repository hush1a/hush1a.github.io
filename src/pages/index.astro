---
import { getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);

// Helper function to get icon path for social
const getSocialIcon = (name: string) => {
  if (name === "GitHub") {
    return "/icons/github.svg";
  } else if (name === "LinkedIn") {
    return "/icons/linkedin.svg";
  } 
  return "";
};
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <!-- Hero Section -->
    <section class="py-20 md:py-32">
      <div class="space-y-8 max-w-3xl">
        <h1 class="animate font-sans text-6xl text-gray-50 font-bold">
          Hello, I'm <span class="text-orange-300">hush</span>.
        </h1>
        
        <article class="animate font-sans text-gray-50 font-light">
          <p>
            Welcome to my page. Projects, experiments, notes, and writeups on cybersecurity + software engineering. Currently learning blue teaming and defensive security.
          </p>
        </article>

        <!-- Credibility Strip -->
        <article class="animate space-y-4 py-6 border-y border-black/15 dark:border-white/15">
          <p class="flex items-start gap-3">
            <span class="text-purple-500">🎓</span>
            <span><span class="font-semibold">CS Undergraduate</span> @ Universitas Gadjah Mada</span>
          </p>
          
          <p class="flex items-start gap-3">
            <span class="text-purple-500">🛠️</span>
            <span><span class="font-semibold">Built projects in:</span> Web Security • APIs • Automation</span>
          </p>
          
          <p class="flex items-start gap-3">
            <span class="text-purple-500">💡</span>
            <span><span class="font-semibold">CTF Player:</span> cybersecurity for OmahTI UGM & KOMATIK</span>
          </p>
        </article>

        <!-- Social CTAs -->
        <div class="animate flex flex-wrap gap-3">
          {SOCIALS.map(SOCIAL => (
            <a 
              href={SOCIAL.HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
              class="group px-6 py-3 rounded-full bg-white/5 backdrop-blur-xs border border-white/10 hover:bg-white/10 hover:border-white/20 transition-all duration-300 flex items-center gap-2"
            >
              <img 
                src={getSocialIcon(SOCIAL.NAME)} 
                alt={SOCIAL.NAME}
                class="w-5 h-5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="underline">{SOCIAL.NAME}</span>
            </a>
          ))}
          <a 
            href={`mailto:${SITE.EMAIL}`}
            aria-label={`Email ${SITE.NAME}`}
            class="group px-6 py-3 rounded-full bg-linear-to-r from-purple-500/20 to-pink-500/20 backdrop-blur-xs border border-purple-500/30 hover:from-purple-500/30 hover:to-pink-500/30 hover:border-purple-500/50 transition-all duration-300 flex items-center gap-2"
          >
            <span class="group-hover:scale-110 transition-transform duration-300">👋</span>
            <span class="font-bold">Email Me!</span>
          </a>
        </div>
      </div>
    </section>

    {blog.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {work.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Work Experience
          </h5>
          <Link href="/work">
            See all work
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}

    {projects.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </Container>
</PageLayout>
