---
import { getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import SocialLinks from "@components/SocialLinks.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME } from "@consts";

const writeups = (await getCollection("writeups"))
  .filter(writeup => !writeup.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_WRITEUPS_ON_HOMEPAGE);

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <!-- Hero Section -->
    <section class="py-20 md:py-32">
      <div class="space-y-8 max-w-3xl">
        <h1 class="animate font-sans text-4xl sm:text-6xl text-black dark:text-white font-bold">
          Hello, I'm <span class="text-orange-600 dark:text-orange-300">hush</span>.
        </h1>

        <article class="animate font-sans font-light">
          <p>
            Welcome to my page. Projects, experiments, notes, and writeups on cybersecurity + software engineering. Currently learning blue teaming and defensive security.
          </p>
        </article>

        <!-- Credibility Strip -->
        <dl class="animate space-y-4 py-6 border-y border-black/15 dark:border-white/15">
          <div class="sm:flex sm:gap-6">
            <dt class="text-xs uppercase tracking-wider opacity-60 sm:w-28 sm:shrink-0 sm:pt-0.5">
              Education
            </dt>
            <dd>CS Undergraduate @ Universitas Gadjah Mada</dd>
          </div>

          <div class="sm:flex sm:gap-6">
            <dt class="text-xs uppercase tracking-wider opacity-60 sm:w-28 sm:shrink-0 sm:pt-0.5">
              Focus
            </dt>
            <dd>Web Security &middot; APIs &middot; Automation</dd>
          </div>

          <div class="sm:flex sm:gap-6">
            <dt class="text-xs uppercase tracking-wider opacity-60 sm:w-28 sm:shrink-0 sm:pt-0.5">
              CTF
            </dt>
            <dd>OmahTI UGM &amp; KOMATIK</dd>
          </div>
        </dl>

        <!-- Social links -->
        <div class="animate">
          <SocialLinks />
        </div>
      </div>
    </section>

    {writeups.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent writeups
          </h5>
          <Link href="/writeups">
            See all writeups
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {writeups.map(writeup => (
            <li>
              <ArrowCard entry={writeup} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {blog.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {work.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Work Experience
          </h5>
          <Link href="/work">
            See all work
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}

    {projects.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </Container>
</PageLayout>
