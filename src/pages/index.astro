---
import { getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import SocialLinks from "@components/SocialLinks.astro";
import AnimatedButton from "@components/AnimatedButton.astro";
import TerminalCard from "@components/TerminalCard.astro";
import SonarGrid from "@components/SonarGrid.astro";
import SkillsGrid from "@components/SkillsGrid.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME } from "@consts";

const writeups = (await getCollection("writeups"))
  .filter(writeup => !writeup.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_WRITEUPS_ON_HOMEPAGE);

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <!-- Whole-page backdrop: pinned to the viewport behind all content, so it
       stays put while the page scrolls over it. -->
  <SonarGrid class="fixed inset-0 -z-10 opacity-40 dark:opacity-30" pingEvery={6} />
  <Container>
    <!-- Hero: heading, one-line intro, actions, and the terminal card. Sized
         to about one screen (main already pads the top by 8rem) so About
         starts below the fold and the backdrop gets the first view. -->
    <section class="relative grid content-start min-h-[calc(100dvh-8rem)] pt-6 md:pt-14 pb-16 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16 lg:items-center">
      <div class="relative space-y-8 max-w-3xl">
        <h1 class="animate text-4xl sm:text-6xl leading-tight tracking-tight text-black dark:text-white font-bold">
          Hello, I'm <span class="text-orange-600 dark:text-orange-300">hush</span>.
        </h1>

        <p class="animate max-w-xl text-lg leading-relaxed">
          CS student at UGM and national CTF finalist. I write about web security, APIs, and the blue-team side I'm learning now.
        </p>

        <div class="animate flex flex-wrap items-center gap-3">
          <AnimatedButton href="/writeups" variant="primary" size="lg">
            Read writeups
            <svg
              slot="icon-right"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-transform duration-200 group-hover:translate-x-0.5"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </AnimatedButton>
          <SocialLinks />
        </div>
      </div>

      <!-- Fills the desktop-only whitespace beside the hero copy -->
      <div class="animate relative hidden lg:block lg:w-96">
        <TerminalCard writeups={writeups.map(writeup => writeup.id)} />
      </div>
    </section>

    <section class="animate space-y-6 py-12">
      <h2 class="font-semibold text-black dark:text-white">
        About me
      </h2>
      <article>
        <p>
          Computer Science undergraduate at Universitas Gadjah Mada with backend experience in Python/FastAPI, Node.js/Express, PostgreSQL, and Redis, plus cloud deployment via Docker, Terraform, and Azure. National CTF finalist and active hackathon participant, currently deepening in system design, cloud computing, and blue teaming. Consulting and product management background alongside the technical work.
        </p>
      </article>

      <!-- Quick facts, moved here from the hero to keep the first screen to
           a single message. -->
      <dl class="space-y-4">
        <div class="sm:flex sm:gap-6">
          <dt class="text-xs uppercase tracking-wider opacity-75 sm:w-28 sm:shrink-0 sm:pt-0.5">
            Education
          </dt>
          <dd>CS Undergraduate @ Universitas Gadjah Mada</dd>
        </div>

        <div class="sm:flex sm:gap-6">
          <dt class="text-xs uppercase tracking-wider opacity-75 sm:w-28 sm:shrink-0 sm:pt-0.5">
            Focus
          </dt>
          <dd>Web Security &middot; APIs &middot; Automation</dd>
        </div>

        <div class="sm:flex sm:gap-6">
          <dt class="text-xs uppercase tracking-wider opacity-75 sm:w-28 sm:shrink-0 sm:pt-0.5">
            Cybersecurity
          </dt>
          <dd>OmahTI UGM &amp; KOMATIK</dd>
        </div>
      </dl>

      <SkillsGrid />
    </section>

    {writeups.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Recent writeups
          </h2>
          <Link href="/writeups">
            See all writeups
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {writeups.map(writeup => (
            <li>
              <ArrowCard entry={writeup} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {blog.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Latest posts
          </h2>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {work.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Work Experience
          </h2>
          <Link href="/work">
            See all work
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}

    {projects.length > 0 && (
      <section class="animate space-y-6 py-12">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Recent projects
          </h2>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </Container>
</PageLayout>
