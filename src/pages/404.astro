---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<PageLayout
  title="Page not found"
  description="The page you were looking for doesn't exist or has moved."
  noindex
>
  <Container>
    <div class="animate space-y-4">
      <p class="text-xs uppercase tracking-wider opacity-75">
        404
      </p>
      <h1 class="text-2xl font-semibold tracking-tight text-black dark:text-white">
        Page not found
      </h1>
      <p class="max-w-xl leading-relaxed">
        The page you were looking for doesn't exist or has moved.
      </p>
      <nav class="flex flex-wrap gap-x-4 gap-y-2 pt-2 text-sm" aria-label="Site links">
        <Link href="/">Home</Link>
        <Link href="/projects">Projects</Link>
        <Link href="/writeups">Writeups</Link>
      </nav>
    </div>
  </Container>
</PageLayout>
