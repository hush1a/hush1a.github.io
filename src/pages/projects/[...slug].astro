---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { cn, readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";
import TechStack from "@components/TechStack.astro";
import ArticleEnhancements from "@components/ArticleEnhancements.astro";

type Neighbor = { id: string; title: string };

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter(project => !project.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  // Previous/next travel within the same `type` group so a technical build
  // never links straight into a consulting case, then wrap at the edges.
  const groups = new Map<string, typeof projects>();
  for (const project of projects) {
    const group = groups.get(project.data.type) ?? [];
    group.push(project);
    groups.set(project.data.type, group);
  }

  return projects.map((project) => {
    const group = groups.get(project.data.type) ?? [project];
    const index = group.indexOf(project);
    const neighbor = (offset: number): Neighbor | null => {
      if (group.length < 2) return null;
      const entry = group[(index + offset + group.length) % group.length];
      return { id: entry.id, title: entry.data.title };
    };

    return {
      params: { slug: project.id },
      props: { project, prev: neighbor(-1), next: neighbor(1) },
    };
  });
}

type Props = {
  project: CollectionEntry<"projects">;
  prev: Neighbor | null;
  next: Neighbor | null;
};

const { project, prev, next } = Astro.props;
const { Content } = await render(project);

const { role, event, eventDetail } = project.data;
// `Back-End Developer at GarudaHacks 7.0 (Safety track)`; either half may be
// absent, so the sentence degrades to whichever field exists.
const bylineBase = role && event ? `${role} at ${event}` : (role ?? event);
const byline = [bylineBase, eventDetail && `(${eventDetail})`]
  .filter(Boolean)
  .join(" ");

// The single detail view, so everything the entry defines is rendered here.
const cover = project.data.image;
const coverAlt = project.data.imageAlt ?? project.data.title;
const coverWidths = cover
  ? [...new Set([600, 1200, 1600].map(width => Math.min(width, cover.width)))]
  : [];
---

<PageLayout title={project.data.title} description={project.data.description} image={cover?.src}>
  <Container>
    <div class="animate">
      <BackToPrev href="/projects">
        Back to projects
      </BackToPrev>
    </div>
    <div class="space-y-3 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="text-sm">
          <FormattedDate date={project.data.date} />
        </div>
        &bull;
        <div class="text-sm">
          {readingTime(project.body)}
        </div>
      </div>
      <h1 class="animate text-2xl font-semibold tracking-tight text-black dark:text-white">
        {project.data.title}
      </h1>
      {byline && (
        <p class="animate text-sm opacity-75">
          {byline}
        </p>
      )}
      <p class="animate max-w-2xl leading-relaxed">
        {project.data.description}
      </p>
      {(project.data.demoURL || project.data.repoURL) && (
        <nav class="animate flex gap-1">
          {project.data.demoURL && (
            <Link href={project.data.demoURL} external>
              demo
            </Link>
          )}
          {project.data.demoURL && project.data.repoURL && (
            <span>/</span>
          )}
          {project.data.repoURL && (
            <Link href={project.data.repoURL} external>
              repo
            </Link>
          )}
        </nav>
      )}
    </div>
    {cover && (
      <div class="animate mb-10">
        <Image
          src={cover}
          alt={coverAlt}
          widths={coverWidths}
          sizes="(min-width: 768px) 768px, 100vw"
          class="w-full rounded-xl border border-black/15 dark:border-white/20"
        />
      </div>
    )}
    {project.data.stack.length > 0 && (
      <div class="animate mb-10">
        <TechStack stack={project.data.stack} />
      </div>
    )}
    <article class="animate">
      <Content />
    </article>
    <ArticleEnhancements />
    {/* Remaining images, after the body. The cover is shown above the stack. */}
    {project.data.gallery.length > 0 && (
      <div class="animate mt-12 space-y-10">
        {project.data.gallery.map(image => (
          <figure class="space-y-3">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[...new Set([800, 1200, 1600].map(w => Math.min(w, image.src.width)))]}
              sizes="(min-width: 768px) 768px, 100vw"
              class="w-full rounded-xl border border-black/15 dark:border-white/20"
            />
            <figcaption class="text-sm opacity-75">
              {image.alt}
            </figcaption>
          </figure>
        ))}
      </div>
    )}
    {(prev || next) && (
      <nav
        aria-label="Project navigation"
        class="animate mt-12 grid gap-4 border-t border-black/10 pt-6 dark:border-white/15 sm:grid-cols-2"
      >
        {prev && (
          <a
            href={`/projects/${prev.id}`}
            class="group rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black/60 dark:focus-visible:outline-white/70"
          >
            <div class="text-xs uppercase tracking-wider opacity-75">
              Previous project
            </div>
            <div class="font-semibold text-black transition-colors duration-300 group-hover:text-black dark:text-white dark:group-hover:text-white">
              {prev.title}
            </div>
          </a>
        )}
        {next && (
          <a
            href={`/projects/${next.id}`}
            class={cn(
              "group rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black/60 dark:focus-visible:outline-white/70",
              !prev && "sm:col-start-2",
              "sm:text-right",
            )}
          >
            <div class="text-xs uppercase tracking-wider opacity-75">
              Next project
            </div>
            <div class="font-semibold text-black transition-colors duration-300 group-hover:text-black dark:text-white dark:group-hover:text-white">
              {next.title}
            </div>
          </a>
        )}
      </nav>
    )}
  </Container>
</PageLayout>
