---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { formatDate } from "@lib/utils";
import { CERTIFICATIONS } from "@consts";

const certifications = (await getCollection("certifications"))
  .sort((a, b) => b.data.issued.valueOf() - a.data.issued.valueOf());

const achievements = (await getCollection("achievements"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const now = new Date();
---

<PageLayout title={CERTIFICATIONS.TITLE} description={CERTIFICATIONS.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <div class="animate">
        <h1 class="text-3xl font-bold text-black dark:text-white">
          {CERTIFICATIONS.TITLE}
        </h1>
        <p class="text-gray-600 dark:text-gray-400 mt-2">
          {CERTIFICATIONS.DESCRIPTION}
        </p>
      </div>

      <section class="space-y-6">
        <h2 class="animate text-xl font-semibold text-black dark:text-white">
          Certifications
        </h2>

        {certifications.length === 0 ? (
          <p class="animate text-sm opacity-75">
            Nothing here yet.
          </p>
        ) : (
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {certifications.map(cert => {
              const expired = cert.data.expires && cert.data.expires < now;
              return (
                <li class="animate space-y-3">
                  {/* Scans are light documents, so they sit on their own light
                      "paper" surface in both themes rather than directly on the
                      dark page background. */}
                  <div class="rounded-lg border border-black/15 dark:border-white/20 bg-white dark:bg-stone-200 p-3">
                    <Image
                      src={cert.data.scan}
                      alt={`${cert.data.name} certificate issued by ${cert.data.issuer}`}
                      widths={[400, 600, 900]}
                      sizes="(min-width: 768px) 600px, 100vw"
                      class="w-full h-full object-contain aspect-4/3"
                    />
                  </div>
                  <div class="space-y-1">
                    <div class="font-semibold text-black dark:text-white">
                      {cert.data.name}
                    </div>
                    <div class="text-sm opacity-75">
                      {cert.data.issuer}
                    </div>
                    <div class="flex flex-wrap items-center gap-2 text-sm opacity-75">
                      <span>Issued {formatDate(cert.data.issued)}</span>
                      {cert.data.expires && (
                        <>
                          <span>&bull;</span>
                          <span>
                            {expired ? "Expired" : "Expires"} {formatDate(cert.data.expires)}
                          </span>
                        </>
                      )}
                    </div>
                    {cert.data.credentialID && (
                      <div class="text-sm opacity-75">
                        Credential ID: {cert.data.credentialID}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>

      <section class="space-y-6">
        <h2 class="animate text-xl font-semibold text-black dark:text-white">
          Achievements
        </h2>

        {achievements.length === 0 ? (
          <p class="animate text-sm opacity-75">
            Nothing here yet.
          </p>
        ) : (
          <ul class="flex flex-col gap-6">
            {achievements.map(item => (
              <li class="animate flex flex-wrap items-start gap-4">
                {item.data.image && (
                  <div class="rounded-lg border border-black/15 dark:border-white/20 bg-white dark:bg-stone-200 p-2 shrink-0">
                    <Image
                      src={item.data.image}
                      alt={`${item.data.title} — ${item.data.event}`}
                      widths={[120, 240]}
                      sizes="120px"
                      class="w-24 h-24 object-contain"
                    />
                  </div>
                )}
                <div class="flex-1 space-y-1 min-w-0">
                  <div class="font-semibold text-black dark:text-white">
                    {item.data.title}
                  </div>
                  <div class="flex flex-wrap items-center gap-2 text-sm opacity-75">
                    <span>{item.data.event}</span>
                    <span>&bull;</span>
                    <span>{formatDate(item.data.date)}</span>
                  </div>
                  {(item.data.rank || item.data.team) && (
                    <div class="flex flex-wrap gap-2 pt-1 text-sm">
                      {item.data.rank && (
                        <span class="px-2 py-1 rounded-sm bg-purple-500/15 text-purple-700 dark:bg-purple-500/20 dark:text-purple-200">
                          {item.data.rank}
                        </span>
                      )}
                      {item.data.team && (
                        <span class="px-2 py-1 rounded-sm bg-black/5 text-black/70 dark:bg-white/10 dark:text-white/70">
                          {item.data.team}
                        </span>
                      )}
                    </div>
                  )}
                  {item.data.description && (
                    <p class="text-sm opacity-75 pt-1">
                      {item.data.description}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </Container>
</PageLayout>
