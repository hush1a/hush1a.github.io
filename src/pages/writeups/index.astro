---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { WRITEUPS } from "@consts";
import { WRITEUP_BADGE } from "@lib/utils";

const writeups = (await getCollection("writeups"))
  .filter(writeup => !writeup.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by CTF
const groupedByCTF = writeups.reduce((acc, writeup) => {
  const ctf = writeup.data.ctf;
  if (!acc[ctf]) acc[ctf] = [];
  acc[ctf].push(writeup);
  return acc;
}, {} as Record<string, typeof writeups>);
---

<PageLayout title={WRITEUPS.TITLE} description={WRITEUPS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-1">
        <h1 class="font-semibold text-black dark:text-white">
          {WRITEUPS.TITLE}
        </h1>
        <p class="text-sm opacity-75">
          {WRITEUPS.DESCRIPTION}
        </p>
      </div>

      <!-- Grouped by CTF -->
      {Object.entries(groupedByCTF).map(([ctf, ctfWriteups]) => (
        <section class="animate space-y-4">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h2 class="font-semibold text-black dark:text-white">
              {ctf}
            </h2>
            <div class="text-sm opacity-75">
              {ctfWriteups.length} {ctfWriteups.length === 1 ? "challenge" : "challenges"}
            </div>
          </div>
          <ul class="space-y-4">
            {ctfWriteups.map(writeup => (
              <li>
                <ArrowCard entry={writeup} />
                <div class="flex flex-wrap gap-2 mt-2 ml-4">
                  <span class={WRITEUP_BADGE.category}>
                    {writeup.data.category}
                  </span>
                  {writeup.data.difficulty && (
                    <span class={WRITEUP_BADGE.difficulty[writeup.data.difficulty]}>
                      {writeup.data.difficulty}
                    </span>
                  )}
                  {writeup.data.points && (
                    <span class={WRITEUP_BADGE.points}>
                      {writeup.data.points} pts
                    </span>
                  )}
                  {writeup.data.solves && (
                    <span class={WRITEUP_BADGE.neutral}>
                      {writeup.data.solves} solves
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </Container>
</PageLayout>
