---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const writeups = (await getCollection("writeups"))
    .filter(writeup => !writeup.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return writeups.map((writeup) => ({
    params: { slug: writeup.slug },
    props: writeup,
  }));
}
type Props = CollectionEntry<"writeups">;

const writeup = Astro.props;
const { Content } = await writeup.render();
---

<PageLayout title={writeup.data.title} description={writeup.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/writeups">
        Back to writeups
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={writeup.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(writeup.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {writeup.data.title}
      </div>
      <div class="animate flex flex-wrap gap-2 mt-4">
        <span class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-sm font-medium">
          {writeup.data.ctf}
        </span>
        <span class="px-3 py-1 rounded-full bg-purple-500/20 text-purple-300 text-sm font-medium">
          {writeup.data.category}
        </span>
        {writeup.data.difficulty && (
          <span class={`px-3 py-1 rounded-full text-sm font-medium ${
            writeup.data.difficulty === 'Easy' ? 'bg-green-500/20 text-green-300' :
            writeup.data.difficulty === 'Medium' ? 'bg-yellow-500/20 text-yellow-300' :
            writeup.data.difficulty === 'Hard' ? 'bg-orange-500/20 text-orange-300' :
            'bg-red-500/20 text-red-300'
          }`}>
            {writeup.data.difficulty}
          </span>
        )}
        {writeup.data.points && (
          <span class="px-3 py-1 rounded-full bg-gray-500/20 text-gray-300 text-sm font-medium">
            {writeup.data.points} points
          </span>
        )}
        {writeup.data.solves && (
          <span class="px-3 py-1 rounded-full bg-gray-500/20 text-gray-300 text-sm font-medium">
            {writeup.data.solves} solves
          </span>
        )}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
