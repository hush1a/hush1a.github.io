---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime, WRITEUP_BADGE } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const writeups = (await getCollection("writeups"))
    .filter(writeup => !writeup.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return writeups.map((writeup) => ({
    params: { slug: writeup.id },
    props: writeup,
  }));
}
type Props = CollectionEntry<"writeups">;

const writeup = Astro.props;
const { Content } = await render(writeup);
---

<PageLayout title={writeup.data.title} description={writeup.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/writeups">
        Back to writeups
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={writeup.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(writeup.body)}
        </div>
      </div>
      <h1 class="animate text-2xl font-semibold tracking-tight text-black dark:text-white">
        {writeup.data.title}
      </h1>
      <div class="animate flex flex-wrap gap-2 pt-3">
        <span class={WRITEUP_BADGE.neutral}>
          {writeup.data.ctf}
        </span>
        <span class={WRITEUP_BADGE.category}>
          {writeup.data.category}
        </span>
        {writeup.data.difficulty && (
          <span class={WRITEUP_BADGE.difficulty[writeup.data.difficulty]}>
            {writeup.data.difficulty}
          </span>
        )}
        {writeup.data.points && (
          <span class={WRITEUP_BADGE.points}>
            {writeup.data.points} pts
          </span>
        )}
        {writeup.data.solves && (
          <span class={WRITEUP_BADGE.neutral}>
            {writeup.data.solves} solves
          </span>
        )}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
