---
// Homepage project tile: cover on top, then event, title, short
// description, and the role at the foot. Built on GradientCard so it matches
// the About highlights and the certification cards.
//
// Role and event come from frontmatter; either can be omitted, in which case
// that part of the tile simply isn't rendered.
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import GradientCard from "@components/GradientCard.astro";

type Props = {
  entry: CollectionEntry<"projects">;
};

const { entry } = Astro.props;

const { role, event } = entry.data;
// Consulting work is marked as such, so it reads apart from the hackathon
// builds when the two kinds share the homepage row.
const eyebrow = entry.data.type === "consulting"
  ? ["Consulting", event].filter(Boolean).join(" · ")
  : event;

const cover = entry.data.image;
// Card width runs ~230px at `md` up to ~400px at `xl`; never upscale past
// the source.
const coverWidths = cover
  ? [...new Set([320, 480, 640].map(width => Math.min(width, cover.width)))]
  : [];
---

<a href={`/projects/${entry.id}`} class="group block h-full rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black/60 dark:focus-visible:outline-white/70">
  <GradientCard class="h-full">
    <div class="flex h-full flex-col">
      {cover && (
        <div class="overflow-hidden rounded-t-[inherit] border-b border-black/10 dark:border-white/10">
          <Image
            src={cover}
            alt=""
            widths={coverWidths}
            sizes="(min-width: 1280px) 400px, (min-width: 768px) 30vw, 100vw"
            format="webp"
            loading="lazy"
            decoding="async"
            draggable="false"
            class="aspect-16/10 w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:scale-[1.04]"
          />
        </div>
      )}
      <div class="flex flex-1 flex-col gap-2 p-6">
        {eyebrow && (
          <div class="text-xs uppercase tracking-wider opacity-75">
            {eyebrow}
          </div>
        )}
        <div class="font-semibold text-black dark:text-white">
          {entry.data.title}
        </div>
        <p class="text-sm line-clamp-3">
          {entry.data.description}
        </p>
        <div class="mt-auto flex items-center justify-between gap-3 pt-4 text-sm">
          <span class="opacity-75">{role}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="size-5 shrink-0 stroke-2 fill-none stroke-current transition-transform duration-300 ease-in-out group-hover:translate-x-0.5 group-hover:text-black dark:group-hover:text-white"
          >
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </div>
      </div>
    </div>
  </GradientCard>
</a>
