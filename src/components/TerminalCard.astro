---
// Interactive hero terminal. The intro (`whoami`, then a short `help` that
// shows visitors what they can type) plays as the card reveals, then the
// prompt becomes a real input with a small set of
// commands: help, about, whoami, ls, open, skills, contact, clear (plus two
// easter eggs). Everything it prints is built here from the content
// collections and @consts at build time, and also exists in the normal page
// sections, so the terminal is a shortcut, never the only way to reach
// anything. Desktop-only: the homepage hides it below `lg`.
import { getCollection } from "astro:content";
import { ABOUT, HIGHLIGHTS, SKILLS, SOCIALS, SITE } from "@consts";

const byDateDesc = <T extends { data: { date: Date } }>(a: T, b: T) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const writeups = (await getCollection("writeups"))
  .filter(writeup => !writeup.data.draft)
  .sort(byDateDesc)
  .map(writeup => ({ id: writeup.id, title: writeup.data.title }));

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort(byDateDesc)
  .map(project => ({ id: project.id, title: project.data.title }));

// One list drives both the intro's `help` line and the interactive `help`
// command, so the two can't disagree.
const HELP: [string, string][] = [
  ["help", "show this list"],
  ["about", "who I am, in a paragraph"],
  ["whoami", "the short version"],
  ["ls [writeups|projects]", "list things"],
  ["open <name>", "go to a page, writeup or project"],
  ["skills", "languages, frameworks, tools"],
  ["contact", "where to find me"],
  ["bonus", "something off the clock"],
  ["clear", "clear the screen"],
];
const commands = HELP.map(([usage]) => usage.split(" ")[0]);

const data = {
  help: HELP,
  about: ABOUT,
  highlights: HIGHLIGHTS,
  skills: SKILLS,
  contact: [
    ...SOCIALS.map(social => ({ name: social.NAME, href: social.HREF })),
    { name: "Email", href: `mailto:${SITE.EMAIL}` },
  ],
  writeups,
  projects,
};
---

<div class="perspective-distant">
  <div
    data-terminal={JSON.stringify(data)}
    class="term-card rounded-lg border border-black/15 dark:border-white/20 bg-stone-100/85 dark:bg-stone-900/85 overflow-hidden"
  >
    <!-- Title bar -->
    <div class="flex items-center gap-2 px-4 py-2.5 border-b border-black/15 dark:border-white/20" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-black/15 dark:bg-white/20"></span>
      <span class="size-2.5 rounded-full bg-black/15 dark:bg-white/20"></span>
      <span class="size-2.5 rounded-full bg-black/15 dark:bg-white/20"></span>
      <span class="ml-2 font-mono text-xs opacity-75">hush@root: ~</span>
    </div>

    <!-- Body: fixed height and scrolls inside, so output never moves the hero -->
    <div data-terminal-body class="h-80 overflow-y-auto px-4 py-4 font-mono text-sm cursor-text">
      <div data-terminal-log class="space-y-3" aria-live="polite">
        <div>
          <div>
            <span class="text-orange-600 dark:text-orange-300">$</span>
            <span class="term-cmd term-cmd-1">whoami</span>
          </div>
          <div class="term-out term-out-1 text-black dark:text-white">hush</div>
        </div>

        <div>
          <div>
            <span class="text-orange-600 dark:text-orange-300">$</span>
            <span class="term-cmd term-cmd-2">help</span>
          </div>
          <div class="term-out term-out-2 flex flex-wrap gap-x-3 text-black dark:text-white">
            {commands.filter(command => command !== "help").map(command => <span>{command}</span>)}
          </div>
        </div>
      </div>

      <form data-terminal-form class="term-out term-prompt mt-3 flex items-center gap-2" autocomplete="off">
        <label for="terminal-input" class="sr-only">Terminal command</label>
        <span class="text-orange-600 dark:text-orange-300" aria-hidden="true">$</span>
        <input
          id="terminal-input"
          data-terminal-input
          type="text"
          spellcheck="false"
          autocapitalize="off"
          enterkeyhint="send"
          placeholder="try 'about'"
          class="min-w-0 flex-1 bg-transparent outline-none text-black dark:text-white placeholder:text-black/55 dark:placeholder:text-white/55 caret-orange-600 dark:caret-orange-300"
        />
      </form>
    </div>
  </div>
</div>

<script>
  import { navigate } from "astro:transitions/client";

  type Entry = { id: string; title: string };
  type Data = {
    help: [string, string][];
    about: string;
    highlights: { LABEL: string; TITLE: string; DETAIL?: string }[];
    skills: { LABEL: string; ITEMS: string[] }[];
    contact: { name: string; href: string }[];
    writeups: Entry[];
    projects: Entry[];
  };

  // Plain text, a link, or a run of both on one line.
  type Part = string | { text: string; href: string; muted?: boolean } | { text: string; accent: true };
  type Line = Part | Part[];

  const PAGES: Record<string, string> = {
    home: "/",
    writeups: "/writeups",
    projects: "/projects",
    work: "/work",
    certs: "/certifications",
  };


  function start(root: HTMLElement) {
    const data = JSON.parse(root.dataset.terminal ?? "{}") as Data;
    const commands = data.help.map(([usage]) => usage.split(" ")[0]);
    const body = root.querySelector<HTMLElement>("[data-terminal-body]");
    const log = root.querySelector<HTMLElement>("[data-terminal-log]");
    const form = root.querySelector<HTMLFormElement>("[data-terminal-form]");
    const input = root.querySelector<HTMLInputElement>("[data-terminal-input]");
    if (!body || !log || !form || !input) return;

    const history: string[] = [];
    let cursor = 0;

    const linkClass = "underline underline-offset-2 decoration-black/30 dark:decoration-white/40 hover:text-orange-600 dark:hover:text-orange-300";

    const renderPart = (part: Part): Node => {
      if (typeof part === "string") return document.createTextNode(part);
      if ("href" in part) {
        const a = document.createElement("a");
        a.href = part.href;
        a.textContent = part.text;
        a.className = linkClass;
        if (/^https?:/.test(part.href)) {
          a.target = "_blank";
          a.rel = "noopener noreferrer";
        }
        return a;
      }
      const span = document.createElement("span");
      span.textContent = part.text;
      span.className = "text-orange-600 dark:text-orange-300";
      return span;
    };

    const print = (lines: Line[], extraClass = "") => {
      const block = document.createElement("div");
      block.className = `whitespace-pre-wrap break-words text-black dark:text-white ${extraClass}`;
      for (const line of lines) {
        const row = document.createElement("div");
        for (const part of Array.isArray(line) ? line : [line]) row.appendChild(renderPart(part));
        block.appendChild(row);
      }
      log.appendChild(block);
    };

    const echo = (command: string) => {
      const row = document.createElement("div");
      row.append(renderPart({ text: "$", accent: true }), document.createTextNode(` ${command}`));
      log.appendChild(row);
    };

    // Named pages, writeup ids and project ids, for `open` and completion.
    const targets = (): Record<string, string> => ({
      ...PAGES,
      ...Object.fromEntries(data.writeups.map(w => [w.id, `/writeups/${w.id}`])),
      ...Object.fromEntries(data.projects.map(p => [p.id, `/projects/${p.id}`])),
    });

    const listing = (entries: Entry[], base: string): Line[] =>
      entries.map(entry => [{ text: entry.id, href: `${base}/${entry.id}` }, `  ${entry.title}`]);

    const run = (raw: string) => {
      const [command = "", ...args] = raw.trim().split(/\s+/);
      const arg = args.join(" ").replace(/\/$/, "");

      switch (command.toLowerCase()) {
        case "":
          return;
        case "help":
          print(data.help.map(([usage, desc]) => [{ text: usage.padEnd(24), accent: true }, desc]));
          return;
        case "about":
          print([data.about]);
          return;
        case "whoami":
          print(["hush", ...data.highlights.map(h => `${h.LABEL.toLowerCase()}: ${h.TITLE}${h.DETAIL ? `, ${h.DETAIL}` : ""}`)]);
          return;
        case "ls":
          if (!arg) print(["writeups/  projects/  work/  certs/"]);
          else if (arg === "writeups") print(listing(data.writeups, "/writeups"));
          else if (arg === "projects") print(listing(data.projects, "/projects"));
          else print([`ls: cannot access '${arg}': No such file or directory`]);
          return;
        case "open":
        case "cd": {
          const path = targets()[arg];
          if (!arg) print([`usage: open <name>. Try 'ls writeups' for names`]);
          else if (!path) print([`open: no such page: ${arg}`]);
          else {
            print([`opening ${path} ...`]);
            window.setTimeout(() => navigate(path), 250);
          }
          return;
        }
        case "skills":
          print(data.skills.map(group => [{ text: group.LABEL.toLowerCase(), accent: true }, `  ${group.ITEMS.join(", ")}`]));
          return;
        case "contact":
          print(data.contact.map(c => [`${c.name.toLowerCase().padEnd(10)}`, { text: c.href.replace(/^mailto:|^https?:\/\//, ""), href: c.href }]));
          return;
        case "clear":
          log.replaceChildren();
          return;
        // Easter eggs. `bonus` is listed in help on purpose; the rest aren't.
        case "bonus":
          print([[
            "im also interested in creative media, check out my photography works: insta ",
            { text: "@xa20_bugle", href: "https://www.instagram.com/xa20_bugle/" },
          ]]);
          return;
        case "sudo":
          print(["nice try. this incident will be reported."]);
          return;
        case "cat":
          print([arg === "flag.txt" ? "flag{y0u_f0und_th3_d3c0y}" : `cat: ${arg || "missing operand"}: No such file or directory`]);
          return;
        default:
          print([`command not found: ${command}. Try 'help'`]);
      }
    };

    form.addEventListener("submit", event => {
      event.preventDefault();
      const value = input.value;
      echo(value);
      if (value.trim()) {
        history.push(value.trim());
        cursor = history.length;
      }
      input.value = "";
      run(value);
      body.scrollTop = body.scrollHeight;
    });

    input.addEventListener("keydown", event => {
      if (event.key === "ArrowUp" || event.key === "ArrowDown") {
        if (!history.length) return;
        event.preventDefault();
        cursor = Math.max(0, Math.min(history.length, cursor + (event.key === "ArrowUp" ? -1 : 1)));
        input.value = history[cursor] ?? "";
        return;
      }
      // Tab completes a command, or the argument of `open` / `ls`. With
      // nothing to complete it is left alone, so Tab still moves focus on
      // and the input never traps keyboard users.
      if (event.key === "Tab" && !event.shiftKey && input.value.trim()) {
        const [command, partial] = input.value.trimStart().split(/\s+/, 2);
        const pool = partial === undefined
          ? commands
          : command === "ls" ? ["writeups", "projects"]
            : ["open", "cd"].includes(command) ? Object.keys(targets())
              : [];
        const prefix = partial ?? command;
        const matches = pool.filter(option => option.startsWith(prefix));
        if (matches.length === 0) return;
        event.preventDefault();
        if (matches.length === 1) {
          input.value = partial === undefined ? `${matches[0]} ` : `${command} ${matches[0]}`;
        } else {
          echo(input.value);
          print([matches.join("  ")]);
          body.scrollTop = body.scrollHeight;
        }
      }
    });

    // Clicking anywhere in the body focuses the prompt, except on links
    // and when the visitor is selecting text to copy.
    body.addEventListener("click", event => {
      if ((event.target as Element).closest("a")) return;
      if (window.getSelection()?.toString()) return;
      input.focus({ preventScroll: true });
    });
  }

  // ClientRouter swaps pages without reloading: bind on each page-load.
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-terminal]");
    if (root) start(root);
  });
</script>

<style>
  /* Animate `transform` directly rather than Tailwind's rotate-y utility:
     --tw-rotate-y is registered with syntax "*", which does not interpolate,
     so a utility-based hover transition would snap instead of glide. Held
     flat while the visitor is typing, so it doesn't tilt away mid-command. */
  .term-card {
    transform: rotateY(-6deg);
    transform-style: preserve-3d;
    transition: transform 500ms ease-out;
  }

  .term-card:hover,
  .term-card:focus-within {
    transform: rotateY(0deg);
  }

  .term-cmd {
    display: inline-block;
    white-space: nowrap;
    overflow: hidden;
    vertical-align: bottom;
  }

  /* Base states are the finished states, so nothing can be permanently
     hidden if the reveal script never runs. The sequence is keyed off the
     `.show` class the scroll-reveal adds, so it starts when the card
     actually appears rather than at an arbitrary page-load offset. */
  /* Widths are in `ch`, which is exact in a monospace face: "whoami" is 6
     characters, "help" is 4. A percentage would size against the parent,
     not the text. */
  :global(.animate.show) .term-cmd-1 {
    --term-width: 6ch;
    animation: term-type 0.4s steps(6) 0.15s both;
  }

  :global(.animate.show) .term-cmd-2 {
    --term-width: 4ch;
    animation: term-type 0.3s steps(4) 0.95s both;
  }

  :global(.animate.show) .term-out-1 {
    animation: term-fade 0.25s ease-out 0.6s both;
  }

  :global(.animate.show) .term-out-2 {
    animation: term-fade 0.25s ease-out 1.35s both;
  }

  :global(.animate.show) .term-prompt {
    animation: term-fade 0.2s ease-out 1.65s both;
  }

  @keyframes term-type {
    from {
      width: 0;
    }
    to {
      width: var(--term-width);
    }
  }

  @keyframes term-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
