---
// Closing panel at the foot of the homepage: a direct way to reach out,
// bookending the hero. The address is also shown with a copy button, since
// a mailto link does nothing for visitors without a mail app set up.
import AnimatedButton from "@components/AnimatedButton.astro";
import GradientCard from "@components/GradientCard.astro";
import { SITE } from "@consts";
---

<GradientCard>
  <div class="relative overflow-hidden rounded-[inherit] p-8 sm:p-12">
    <!-- Same accent wash as the featured About tile. -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_90%_at_100%_0%,var(--color-orange-500)_0%,transparent_60%)] opacity-15 dark:bg-[radial-gradient(ellipse_80%_90%_at_100%_0%,var(--color-orange-300)_0%,transparent_60%)] dark:opacity-15" aria-hidden="true"></div>
    <div class="relative space-y-6">
      <div class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-black dark:text-white">
          Let's get in touch
        </h2>
        <p class="max-w-xl leading-relaxed">
          Have an opportunity, a project idea, or a question about one of my writeups? My inbox is open, and I'll get back to you.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <AnimatedButton href={`mailto:${SITE.EMAIL}`} variant="primary" size="lg">
          <svg
            slot="icon-left"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M1.5 5.25A2.25 2.25 0 0 1 3.75 3h16.5a2.25 2.25 0 0 1 2.25 2.25v.38l-10.5 6.06L1.5 5.63zm0 3.11V18.75A2.25 2.25 0 0 0 3.75 21h16.5a2.25 2.25 0 0 0 2.25-2.25V8.36l-9.94 5.74a1.5 1.5 0 0 1-1.62 0z" />
          </svg>
          Email me
        </AnimatedButton>
        <button
          type="button"
          data-copy-email={SITE.EMAIL}
          class="group inline-flex items-center gap-2 rounded-md text-sm transition-colors duration-300 hover:text-black dark:hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black/60 dark:focus-visible:outline-white/70"
        >
          <span>{SITE.EMAIL}</span>
          <span class="inline-flex items-center gap-1 rounded-md border border-black/15 dark:border-white/20 px-2 py-0.5 text-xs group-hover:border-black/30 dark:group-hover:border-white/40">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="size-3.5 stroke-2 fill-none stroke-current"
            >
              <rect x="9" y="9" width="12" height="12" rx="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span data-copy-label aria-live="polite">Copy</span>
          </span>
        </button>
      </div>
    </div>
  </div>
</GradientCard>

<script>
  // Delegated, so it survives ClientRouter page swaps without rebinding.
  document.addEventListener("click", async event => {
    const button = (event.target as Element | null)?.closest<HTMLElement>("[data-copy-email]");
    if (!button) return;
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    try {
      await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
      if (label) label.textContent = "Copied";
    } catch {
      if (label) label.textContent = "Copy failed";
    }
    window.setTimeout(() => {
      if (label) label.textContent = "Copy";
    }, 2000);
  });
</script>
