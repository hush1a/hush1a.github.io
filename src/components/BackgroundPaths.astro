---
// Decorative backdrop: two mirrored fans of 36 curves that draw themselves
// along their length. Ported from 21st.dev's "Background Paths" (Framer
// Motion animating each SVG path's pathLength / pathOffset / opacity).
//
// Rendered on a <canvas> rather than as animated SVG. Animated SVG paths are
// repainted as part of the page every frame, which in Chrome also made the
// surrounding text and header flicker. A canvas redraws only its own layer.
// Fills its parent; position it from the outside.
import { cn } from "@lib/utils";

type Props = {
  class?: string;
};

const { class: className } = Astro.props;

// Stand-in for the original's Math.random() durations (20-30s). Seeded so
// the markup is identical between builds instead of churning every deploy.
const jitter = (i: number, seed: number) => {
  const x = Math.sin(i * 12.9898 + seed * 78.233) * 43758.5453;
  return x - Math.floor(x);
};

type Point = [number, number];

// Arc length of a cubic Bezier by sampling. The canvas dash pattern needs
// real lengths, since canvas has no equivalent of SVG's pathLength="1".
const bezierLength = (p0: Point, p1: Point, p2: Point, p3: Point) => {
  let length = 0;
  let prev = p0;
  for (let step = 1; step <= 64; step++) {
    const t = step / 64;
    const u = 1 - t;
    const pt: Point = [0, 1].map(k =>
      u * u * u * p0[k] + 3 * u * u * t * p1[k] + 3 * u * t * t * p2[k] + t * t * t * p3[k]
    ) as Point;
    length += Math.hypot(pt[0] - prev[0], pt[1] - prev[1]);
    prev = pt;
  }
  return length;
};

// The original's path formula, unchanged.
const paths = [1, -1].flatMap(position =>
  Array.from({ length: 36 }, (_, i) => {
    const x = (n: number) => n - i * 5 * position;
    const y = (n: number) => n - i * 6;
    const start: Point = [-x(380), -(189 + i * 6)];
    const c1: Point = [-x(312), y(216)];
    const mid: Point = [x(152), y(343)];
    const c2: Point = [x(616), y(470)];
    const end: Point = [x(684), y(875)];
    return {
      d: `M${start[0]} ${start[1]}C${start[0]} ${start[1]} ${c1[0]} ${c1[1]} ${mid[0]} ${mid[1]}C${c2[0]} ${c2[1]} ${end[0]} ${end[1]} ${end[0]} ${end[1]}`,
      length: Math.round(bezierLength(start, start, c1, mid) + bezierLength(mid, c2, end, end)),
      width: +(0.5 + i * 0.03).toFixed(2),
      opacity: +Math.min(0.1 + i * 0.03, 1).toFixed(2),
      duration: +(20 + jitter(i, position) * 10).toFixed(2),
      // Where in its cycle each line starts. The original starts every line
      // in sync, so for the first minute the whole fan slides on and off
      // together; staggering opens straight into the flowing steady state.
      phase: +jitter(i, position + 7).toFixed(3),
    };
  })
);
---

<div
  data-bg-paths={JSON.stringify(paths)}
  class={cn("pointer-events-none overflow-hidden text-stone-900 dark:text-white", className)}
  aria-hidden="true"
>
  <canvas class="absolute inset-0 size-full"></canvas>
  {/* Edge fades in the page colour: a soft vignette, and a bottom fade so
      the lines never end in a hard edge. Static, so they cost nothing per
      frame. */}
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_75%_80%_at_60%_50%,transparent_30%,var(--color-stone-100)_100%)] dark:bg-[radial-gradient(ellipse_75%_80%_at_60%_50%,transparent_30%,var(--color-stone-900)_100%)]"></div>
  <div class="absolute inset-x-0 bottom-0 h-1/4 bg-linear-to-b from-transparent to-stone-100 dark:to-stone-900"></div>
</div>

<script>
  type BgPath = { d: string; length: number; width: number; opacity: number; duration: number; phase: number };

  // The SVG viewBox the path coordinates are written in.
  const VIEW_W = 696;
  const VIEW_H = 316;

  let stop: (() => void) | undefined;

  function start(root: HTMLElement) {
    const canvas = root.querySelector("canvas");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    const paths = (JSON.parse(root.dataset.bgPaths ?? "[]") as BgPath[])
      .map(p => ({ ...p, path: new Path2D(p.d) }));

    // Line colour follows the theme via the wrapper's text colour; re-read
    // only when the theme class on <html> changes, not every frame.
    let color = getComputedStyle(root).color;
    const themeObserver = new MutationObserver(() => {
      color = getComputedStyle(root).color;
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

    // Map the viewBox onto the canvas like preserveAspectRatio="xMidYMid
    // slice": scale to cover, centre the overflow.
    let transform: [number, number, number] = [1, 0, 0];
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      const scale = Math.max(width / VIEW_W, height / VIEW_H);
      transform = [
        scale * dpr,
        ((width - VIEW_W * scale) / 2) * dpr,
        ((height - VIEW_H * scale) / 2) * dpr,
      ];
    };
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(canvas);
    resize();

    const t0 = performance.now();
    let frame = 0;

    // Each path loops over its own duration. As in the original, the visible
    // segment grows from 30% of the path to all of it while sliding along
    // (pathOffset 0 -> 1 -> 0), and opacity pulses 0.3 -> 0.6 -> 0.3. The
    // length eases back too, so the loop has no snap where it restarts.
    const draw = (now: number) => {
      const seconds = (now - t0) / 1000;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.setTransform(transform[0], 0, 0, transform[0], transform[1], transform[2]);
      ctx.strokeStyle = color;

      for (const p of paths) {
        const progress = ((seconds / p.duration) + p.phase) % 1;
        const wave = 1 - Math.abs(1 - 2 * progress); // 0 -> 1 -> 0
        const visible = 0.3 + 0.7 * wave;
        ctx.setLineDash([visible * p.length, p.length]);
        ctx.lineDashOffset = -wave * p.length;
        ctx.globalAlpha = Math.min(p.opacity * (0.3 + 0.3 * wave), 1);
        ctx.lineWidth = p.width;
        ctx.stroke(p.path);
      }

      frame = requestAnimationFrame(draw);
    };
    frame = requestAnimationFrame(draw);

    stop = () => {
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      themeObserver.disconnect();
      stop = undefined;
    };
  }

  // ClientRouter swaps pages without reloading, so start on every page that
  // has the backdrop and tear down before leaving it.
  document.addEventListener("astro:page-load", () => {
    stop?.();
    const root = document.querySelector<HTMLElement>("[data-bg-paths]");
    if (root) start(root);
  });
  document.addEventListener("astro:before-swap", () => stop?.());
</script>
