---
// Decorative looping ASCII-art video, made with the 21st.dev ASCII editor
// and baked to its rendered output. Fills its parent, so position it from
// the outside: <AsciiArt class="absolute inset-0" />.
//
// The clip is light glyphs on pure black. Blend modes make that black
// vanish into the page: `screen` in dark mode, and in light mode the frames
// are inverted (hue-rotated back so the tints keep their colour) and
// `multiply`-blended, which drops the now-white background instead.
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<video
  class:list={["ascii-art", className]}
  src="/ascii/hero.mp4"
  poster="/ascii/hero-poster.webp"
  data-ascii-art
  loop
  muted
  playsinline
  preload="metadata"
  aria-hidden="true"
  tabindex="-1"
></video>

<script>
  // Started from script rather than `autoplay` so reduced-motion users get
  // the static poster frame. Runs on every page-load because ClientRouter
  // swaps the page without re-executing module scripts.
  document.addEventListener("astro:page-load", () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll<HTMLVideoElement>("[data-ascii-art]").forEach(video => {
      video.play().catch(() => {});
    });
  });
</script>

<style>
  .ascii-art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    filter: invert(1) hue-rotate(180deg);
    mix-blend-mode: multiply;
  }

  :global(.dark) .ascii-art {
    filter: none;
    mix-blend-mode: screen;
  }
</style>
